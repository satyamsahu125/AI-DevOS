# AI DevOS — Environment Configuration
# Copy this file to .env and fill in values

# ━━━━━━━━━━━━━━━━━━━━━━━━━━
# LLM PROVIDER
# ━━━━━━━━━━━━━━━━━━━━━━━━━━
# Choose: "ollama" (local, free) or "bedrock" (AWS)
LLM_PROVIDER=ollama

# Ollama settings (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# AWS Bedrock settings (used when LLM_PROVIDER=bedrock)
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_BEARER_TOKEN_BEDROCK=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━
# DATABASE PATHS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━
MEMORY_DB_PATH=backend/app/memory/memory.db
KNOWLEDGE_DB_PATH=backend/app/memory/knowledge.db
LEARNING_DB_PATH=backend/app/memory/learning.db
LESSONS_DB_PATH=backend/app/memory/lessons.db
COSTS_DB_PATH=backend/app/memory/costs.db
WORKSPACE_ROOT=temp-workspace

# ━━━━━━━━━━━━━━━━━━━━━━━━━━
# PIPELINE SETTINGS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━
MAX_RETRIES=3
REQUIRE_HUMAN_APPROVAL=false
SKIP_QA=false

# ━━━━━━━━━━━━━━━━━━━━━━━━━━
# SERVER
# ━━━━━━━━━━━━━━━━━━━━━━━━━━
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
