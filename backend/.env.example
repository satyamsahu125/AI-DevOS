# AI DevOS — Environment Configuration
# Copy this file to .env and fill in values for your chosen provider.
# All configuration is driven from this file — no YAML edits needed.

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# LLM PROVIDER — choose one: ollama | gemini | bedrock | claude
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
LLM_PROVIDER=ollama

# ── OLLAMA (local, free) ─────────────────────────────────────────
# Used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# LLM_MODEL overrides OLLAMA_MODEL when set (works for any provider)
# LLM_MODEL=qwen3:8b

# ── GOOGLE GEMINI (cloud, AI Studio free tier available) ─────────
# Used when LLM_PROVIDER=gemini
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# LLM_MODEL=gemini-2.0-flash
# Available models: gemini-2.0-flash | gemini-2.0-flash-lite | gemini-1.5-flash | gemini-1.5-pro

# ── AWS BEDROCK (cloud, pay-per-token) ──────────────────────────
# Used when LLM_PROVIDER=bedrock
# Auth option 1: Bedrock API key (Bearer token — from AWS Console → Bedrock → API Keys)
BEDROCK_API_KEY=
BEDROCK_REGION=us-east-1
# Auth option 2: Standard AWS credentials (SigV4 — requires boto3)
# If BEDROCK_API_KEY is empty, the provider falls back to boto3 credential chain
# (env vars below, ~/.aws/credentials, IAM role — standard AWS auth order)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=           # only needed for temporary credentials
# LLM_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
# Bedrock model IDs:
#   Anthropic : anthropic.claude-3-5-sonnet-20241022-v2:0
#               anthropic.claude-3-haiku-20240307-v1:0
#   DeepSeek  : us.deepseek.r1-v1:0
#               us.deepseek.deepseek-v3-0324-v1:0
#   Amazon    : amazon.nova-pro-v1:0
#               amazon.nova-lite-v1:0
#   Meta      : meta.llama3-3-70b-instruct-v1:0
#   Qwen      : qwen.qwen3-coder-480b-a35b-v1:0

# ── ANTHROPIC CLAUDE DIRECT API ─────────────────────────────────
# Used when LLM_PROVIDER=claude
# Get your API key at: https://console.anthropic.com
CLAUDE_API_KEY=
# LLM_MODEL=claude-3-5-sonnet-20241022

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DATABASE PATHS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
MEMORY_DB=data/memory.sqlite
KNOWLEDGE_DB=data/knowledge.sqlite
LEARNING_DB=data/learning.sqlite
LESSONS_DB=data/lessons.sqlite
COSTS_DB=data/costs.sqlite
WORKSPACE_ROOT=temp-workspace

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PIPELINE SETTINGS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
MAX_RETRIES=3
MAX_DEV_REVIEW_ITERATIONS=2
MAX_QA_ITERATIONS=2
MAX_SPEC_FIX_ITERATIONS=2
REQUIRE_HUMAN_APPROVAL=false
SKIP_QA=false

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SERVER
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# LOG_FORMAT=text          # "text" (default, human-readable) or "json" (production)

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PHASE 6 — SECURITY & INFRASTRUCTURE
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── API Key Authentication ────────────────────────────────────────
# Comma-separated list of valid bearer tokens for X-API-Key header.
# When empty or unset, auth is DISABLED (all requests pass through).
# Required in production to prevent unauthorized Bedrock/Gemini usage.
# VALID_API_KEYS=key1,key2,key3

# ── Per-user project count limit ─────────────────────────────────
# Reject project creation when the user already owns this many projects.
# Default: 20. Set to a lower value in shared/demo environments.
# MAX_PROJECTS_PER_KEY=20

# ── Rate Limiting ────────────────────────────────────────────────
# Disabled by default. Enable in production to prevent abuse.
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_PROJECT_CREATE=10    # project creates per minute per API key (default: 10)
# RATE_LIMIT_PIPELINE=5           # pipeline starts per hour per user (default: 5)
# RATE_LIMIT_DEFAULT=60           # general requests per minute (default: 60)
# RATE_LIMIT_PROJECT_PATHS=/api/v1/projects,/projects   # paths subject to create limit

# ── Request Size Limit ───────────────────────────────────────────
# Reject request bodies larger than this byte count (default: 51200 = 50 KB).
# Prevents unbounded description text from inflating LLM prompt costs.
# REQUEST_MAX_BODY_BYTES=51200

# ── Celery Task Queue ────────────────────────────────────────────
# Required only when running the Celery worker (docker-compose worker service).
# When unset, pipeline runs fall back to daemon threads (development mode).
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Observability: Prometheus ────────────────────────────────────
# Exposes /metrics endpoint for Prometheus scraping.
# Disabled by default (no external dependency needed in dev).
# PROMETHEUS_ENABLED=false

# ── Observability: OpenTelemetry Tracing ─────────────────────────
# Send traces to an OTLP-compatible collector (Jaeger, Tempo, etc.).
# When empty or unset, tracing is disabled (no-op).
# OTEL_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=ai-devos
